
// ============================================================
// Manifest
// ============================================================
manifest {
    name            = 'small RNA-Seq pipeline'
    author          = 'Leinal Alen Sejour'
    version         = '2.0.0'
    nextflowVersion = '25.10.0'
    description     = 'small RNA-Seq QC, trimming, mapping and quantification pipeline'
    mainScript      = 'small_RNA-Seq-pipeline-v1.nf'
}

nextflow.enable.dsl = 2

profiles {

    conda_env {

        params {
            perl_modules_dir = "${CONDA_PREFIX}/lib/perl5/5.32/site_perl"
            manatee_file = ""
            primary_assembly = ""
            bowtie_genome_index = ""
            nc_annotation = ""
            transcriptome_index = ""

        }
        executor {

            name 	  	 = 'local'
            cpus		   = 8
            queueSize  = 8
            pollInterval	 = '30sec'
            memory    	 = '300 GB'

        }

    }

}
